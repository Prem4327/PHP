using System;
using 
System.Collections.Generic; 
using System.Linq;
using System.Text;
namespace ConsoleApplication1
{
class Program
{
class first
{
private int a;
public int p_a // Property for the private variable a
{
get
{
return a;
}
set
{
a = value;
}
}
}
static void Main(string[] args)
{
first obj = new first();
// This will raise the set method of the property p_a
obj.p_a = 95;
// This will raise the get method of the property p_a
Console.WriteLine(obj.p_a);
Console.ReadKey();
}
}
}

