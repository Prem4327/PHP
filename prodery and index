using System;
using 
System.Collections.Generic;
using System.Linq;
using System.Text;
namespace ConsoleApplication1
{
class Program
{
class first
{
private string[] b = new string[3];
public string this[int x] // Indexer for the private string array variable b
{
get
{
return b[x];
}
set
{
b[x] = value;
}
}
}
static void Main(string[] args)
{
first obj = new first();
obj[2] = "welcome";// This will raise the set method of the indexer
Console.WriteLine(obj[2]); // This will raise the get method of the indexer
Console.ReadKey();
}
}
}
