using System;

namespace ElectricityBill
{
    // Interface 1: only declares read()
    public interface inpread
    {
        void read();
    }

    // Interface 2: only declares cal()
    public interface billcal
    {
        void cal();
    }

    // Class implements both interfaces
    public class electricity : inpread, billcal
    {
        public int cno, punits, cunits, units;
        public string cname;
        public double rate;

        // Take input from the user
        public void read()
        {
            Console.Write("Enter the customer number : ");
            cno = Convert.ToInt32(Console.ReadLine());

            Console.Write("Enter the customer name : ");
            cname = Console.ReadLine();

            Console.Write("Enter the Previous month units : ");
            punits = Convert.ToInt32(Console.ReadLine());

            Console.Write("Enter the current month units : ");
            cunits = Convert.ToInt32(Console.ReadLine());
        }

        // Calculate units used and the bill amount
        public void cal()
        {
            units = cunits - punits;

            if (units <= 50)
                rate = units * 1.45;
            else if (units > 50 && units <= 100)
                rate = (units - 50) * 2.3 + 50 * 1.45;
            else if (units > 100 && units <= 200)
                rate = (units - 100) * 3.2 + 50 * 2.3 + 50 * 1.45;
            else if (units > 200)
                rate = (units - 200) * 4.5 + 100 * 3.2 + 50 * 2.3 + 50 * 1.45;
        }
    }

    // Child class: inherits electricity and adds display()
    public class ebbill : electricity
    {
        public void display()
        {
            Console.WriteLine();
            Console.WriteLine("EB Bill Details");
            Console.WriteLine("===============");
            Console.WriteLine("The customer number is {0}", cno);
            Console.WriteLine("The customer name is {0}", cname);
            Console.WriteLine("The previous month's unit is {0}", punits);
            Console.WriteLine("The Current month units is {0}", cunits);
            Console.WriteLine("The Total number of units consumed by the customer in this month is {0}", units);
            Console.WriteLine("The Total amount to be paid by the customer is {0}", rate);
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            ebbill e1 = new ebbill();

            e1.read();
            e1.cal();
            e1.display();

            Console.ReadKey();
        }
    }
}
